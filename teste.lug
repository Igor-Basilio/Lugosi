def float insfiami(float n) 
{
    let float n1, result, n2;    
    n1 := 0;
    
    while(  ((n1 * 2)  < n) ) do
    {
        result := ( n1 + n2 );
        n1 := (( n1 + 1 ) + ( 3 + 4 )) ;
    };

    return result;
}

